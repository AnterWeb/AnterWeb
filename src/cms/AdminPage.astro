import '@fontsource/italiana/400.css';
import '@fontsource-variable/jost';
import './admin.css';
import { Admin } from './admin';

export const prerender = false;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
