---
import '@fontsource/italiana/400.css';
import '@fontsource-variable/jost';
import '../styles/global.css';
import Seo from '../components/seo/Seo.astro';
// Estadísticas de Vercel (visitas y velocidad real), sin cookies. Se activan en el proyecto de la clienta;
// mientras no estén activas, sus scripts no cargan nada. El panel (/keystatic) no usa este layout.
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex } = Astro.props;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ece6d9" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Seo title={title} description={description} noindex={noindex} />
    <!-- Anti-parpadeo: marca JS activo antes del primer pintado (docs/experience/motion.md) -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <!-- Elementos fijos: deben vivir fuera del contenido que transforma ScrollSmoother -->
    <slot name="fixed" />

    <div id="smooth-wrapper">
      <div id="smooth-content">
        <slot />
      </div>
    </div>

    <script>
      import { initSmooth } from '../scripts/motion/smooth';
      import { initReveals } from '../scripts/motion/reveal';

      initSmooth();
      initReveals();
    </script>
    <Analytics />
    <SpeedInsights />
  </body>
</html>
