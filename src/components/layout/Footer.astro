---
// Cierre: el wordmark del logo se arma letra por letra con el scroll, sobre el mismo fondo de la página.
// Alrededor, dos clips del taller con la gramática del hero: sueltos a distintas escalas, uno en blanco y negro
// y un texto vertical en terracota (la página cierra como abre).
import { getImage } from 'astro:assets';
import { films } from '../../data/films';
import { nav, site } from '../../data/site';
import InstagramIcon from '../ui/icons/InstagramIcon.astro';
import WhatsAppIcon from '../ui/icons/WhatsAppIcon.astro';
import Wordmark from '../ui/Wordmark.astro';

const year = new Date().getFullYear();
const clips = await Promise.all(
  films.map(async (film) => ({ ...film, poster: (await getImage({ src: film.poster, width: 960, format: 'webp' })).src })),
);
---

<footer class="footer" data-footer>
  <div class="footer__cols wrap">
    <nav aria-label="Pie de página">
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <ul>
      <li><a class="footer__social" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer"><WhatsAppIcon size={16} /> {site.whatsappDisplay}</a></li>
      <li><a class="footer__social" href={site.instagramUrl} target="_blank" rel="noopener noreferrer"><InstagramIcon size={16} /> {site.instagramHandle}</a></li>
      <li>{site.area}, {site.city}</li>
    </ul>
  </div>

  <div class="footer__logo">
    {clips.map((clip) => (
      <div class:list={['footer__film', `footer__film--${clip.orientation}`]} data-parallax={clip.parallax} aria-hidden="true">
        <figure class:list={{ 'is-mono': clip.monochrome }} data-clip>
          <video data-film src={clip.src} poster={clip.poster} muted loop playsinline preload="none" disablepictureinpicture></video>
        </figure>
        {clip.note && <p class="footer__note display">{clip.note}</p>}
      </div>
    ))}
    <p class="footer__mark">
      <span class="sr-only">Anter</span>
      <Wordmark letterAttr="data-footer-letter" />
    </p>
    <p class="footer__house">House</p>
    <p class="footer__tagline">{site.tagline}</p>
  </div>

  <p class="footer__legal wrap">
    <span>© {year} {site.name}</span>
    <span>Hecho a mano en {site.city}</span>
  </p>
</footer>

<style>
  .footer {
    padding-top: calc(var(--section-y) * 0.6);
    overflow: hidden;
  }

  .footer__cols {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 1.6rem;
    border-top: 1px solid var(--line);
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .footer__cols ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 2rem;
  }

  .footer__cols a {
    transition: color 0.4s var(--ease-out);
  }

  .footer__social {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer__cols a:hover {
    color: var(--terracota);
  }

  .footer__logo {
    position: relative;
    display: grid;
    align-content: center;
    min-height: clamp(22rem, 31vw, 29rem);
    padding-block: clamp(2rem, 5vw, 4rem) 2rem;
    text-align: center;
  }

  /* Clips sueltos a los lados del wordmark, a distintas escalas (gramática del hero) */
  .footer__film {
    position: absolute;
  }

  .footer__film figure {
    margin: 0;
    overflow: hidden;
    background: var(--fondo-soft);
  }

  .footer__film video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .footer__film .is-mono video {
    filter: grayscale(1) contrast(1.06);
  }

  .footer__film--landscape {
    left: 5%;
    top: 0;
    width: clamp(13rem, 19vw, 19rem);
  }

  .footer__film--landscape figure {
    aspect-ratio: 3 / 2;
  }

  .footer__film--portrait {
    right: 10%;
    top: 16%;
    width: clamp(8rem, 11vw, 11rem);
  }

  .footer__film--portrait figure {
    aspect-ratio: 2 / 3;
  }

  /* Texto vertical junto al clip, como "Hecho a tu medida" en el hero */
  .footer__note {
    position: absolute;
    top: 0;
    left: calc(100% + 0.8rem);
    writing-mode: vertical-rl;
    rotate: 180deg;
    font-size: clamp(1rem, 1.3vw, 1.3rem);
    letter-spacing: 0.12em;
    white-space: nowrap;
    color: var(--terracota);
  }

  /* En móvil no caben a los lados: van juntos arriba del wordmark, escalonados */
  @media (max-width: 860px) {
    .footer__logo {
      grid-template-columns: 50vw 30vw;
      justify-content: space-between;
      align-items: end;
      min-height: 0;
      padding-inline: var(--gutter);
    }

    .footer__film {
      position: relative;
      inset: auto;
      width: auto;
      margin-bottom: 2.5rem;
    }

    .footer__film--landscape {
      margin-bottom: 4.5rem;
    }

    .footer__note {
      left: auto;
      right: calc(100% + 0.5rem);
    }

    .footer__logo > :not(.footer__film) {
      grid-column: 1 / -1;
    }
  }

  .footer__mark {
    width: min(46vw, 860px);
    margin-inline: auto;
  }

  @media (max-width: 860px) {
    .footer__mark {
      width: 78vw;
    }
  }

  .footer__house {
    margin-top: clamp(0.8rem, 1.6vw, 1.6rem);
    font-size: clamp(0.8rem, 1.3vw, 1.25rem);
    letter-spacing: 0.75em;
    padding-left: 0.75em;
    text-transform: uppercase;
  }

  .footer__tagline {
    margin-top: 0.5rem;
    font-size: clamp(0.75rem, 1.05vw, 1rem);
    letter-spacing: 0.62em;
    padding-left: 0.62em;
  }

  .footer__legal {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.4rem;
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tinta-soft);
  }

  @media (max-width: 760px) {
    .footer__cols {
      flex-direction: column;
    }

    .footer__legal {
      flex-direction: column;
      align-items: center;
    }
  }
</style>

<script>
  import { initFooter } from '../../scripts/motion/footer';
  import { initFilms } from '../../scripts/motion/films';

  const footer = document.querySelector<HTMLElement>('[data-footer]');
  if (footer) {
    initFooter(footer);
    initFilms(footer);
  }
</script>
