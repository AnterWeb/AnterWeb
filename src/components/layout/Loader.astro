---
// Pantalla de carga: el clip del cuaderno que se hojea, en blanco y negro, sobre el fondo y con el wordmark debajo.
// Cuando la página está lista, el clip vuela al lugar de la foto en blanco y negro del hero (la misma escena:
// la diseñadora en su cuaderno) y se funde en ella mientras entra el resto del hero.
// La orquesta scripts/motion/loader.ts; el hero espera a que se abra (afterLoader).
// Solo existe con JS y movimiento permitido. Si el script no corre, se desvanece sola (loader-failsafe).
import { getImage } from 'astro:assets';
import Wordmark from '../ui/Wordmark.astro';
import { filmById } from '../../data/films';

const film = filmById('cuaderno');
const poster = await getImage({ src: film.poster, width: 640, format: 'webp' });
---

<div class="loader" data-loader aria-hidden="true">
  <div class="loader__panel" data-loader-panel></div>
  <div class="loader__center">
    <figure class="loader__film" data-loader-film>
      <video src={film.src} poster={poster.src} muted loop playsinline preload="auto" disablepictureinpicture></video>
    </figure>
    <div class="loader__mark">
      <Wordmark letterAttr="data-loader-letter" />
    </div>
  </div>
</div>

<style>
  .loader {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .loader {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 200;
      animation: loader-failsafe 0.6s ease 6s forwards;
    }
  }

  @keyframes loader-failsafe {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  .loader__panel {
    position: absolute;
    inset: 0;
    background: var(--fondo);
  }

  .loader__center {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: clamp(1.2rem, 2.4vw, 1.8rem);
  }

  /* El clip, como una foto suelta del collage: se destapa de abajo hacia arriba (lo anima el script) */
  .loader__film {
    width: clamp(9rem, 15vw, 14rem);
    aspect-ratio: 2 / 3;
    margin: 0;
    overflow: hidden;
    background: var(--fondo-soft);
    clip-path: inset(100% 0 0 0);
  }

  .loader__film video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.06);
  }

  .loader__mark {
    width: clamp(6.5rem, 10vw, 9rem);
    color: var(--tinta);
  }

  /* Las letras entran con el script; así no parpadean antes */
  .loader__mark :global([data-loader-letter]) {
    opacity: 0;
  }

  @media (max-width: 860px) {
    .loader__film {
      width: 42vw;
    }

    .loader__mark {
      width: 30vw;
    }
  }
</style>

<script>
  import { initLoader } from '../../scripts/motion/loader';

  const loader = document.querySelector<HTMLElement>('[data-loader]');
  if (loader) initLoader(loader);
</script>
