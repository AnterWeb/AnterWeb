---
// <head> de SEO: title, description, canonical, Open Graph, Twitter y JSON-LD.
// La URL base sale de `site` en astro.config.mjs; nunca se escribe el dominio a mano.
import { getImage } from 'astro:assets';
import { site } from '../../data/site';
import { buildJsonLd, defaultDescription, defaultTitle } from '../../data/seo';
import { getCollection, getServices } from '../../data/cms';
import ogCover from '../../assets/og/portada.jpg';

interface Props {
  title?: string;
  description?: string;
  /** Páginas que no deben indexarse (404). Omite canonical y JSON-LD. */
  noindex?: boolean;
}

const { title = defaultTitle, description = defaultDescription, noindex = false } = Astro.props;

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, siteUrl).href;

// Imagen para compartir 1200×630: la portada de revista que arma scripts/og-image.mjs (npm run og).
const ogAlt =
  'Portada de Anter House: el wordmark ANTER sobre manos que drapean satín rosa, la colección de temporada y la diseñadora bocetando en el taller';
const og = await getImage({ src: ogCover, width: 1200, height: 630, format: 'jpg', quality: 90 });
const ogImage = new URL(og.src, siteUrl).href;

// Fotos de la colección para los productos del JSON-LD (portada de cada opción)
const jsonLd = noindex
  ? null
  : await (async () => {
      const [collection, services] = await Promise.all([getCollection(), getServices()]);
      const urls = new Map<string, string>();
      for (const option of collection.pieces.flatMap((piece) => piece.options)) {
        const cover = option.photos[0];
        if (urls.has(cover.image.src)) continue;
        const photo = await getImage({ src: cover.image, width: 1200, format: 'jpg' });
        urls.set(cover.image.src, new URL(photo.src, siteUrl).href);
      }
      return buildJsonLd(siteUrl, { imageUrl: ogImage, collection, services, photoUrl: (p) => urls.get(p.image.src)! });
    })();
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

<meta property="og:type" content="website" />
<meta property="og:locale" content="es_MX" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<link rel="sitemap" href="/sitemap.xml" />
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
