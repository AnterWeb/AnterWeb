---
// 01 — Nuestra esencia. Maquetada como página de revista de moda:
// capital, cuerpo a dos columnas con entrada en versalitas y cita destacada. Los textos se editan en el panel
// (Textos de la página); las fotos del collage son fijas (work.ts).
// Copy en borrador: validar con la clienta (docs/pages/home.md).
import { Image } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import WordReveal from '../ui/WordReveal.astro';
import { byId } from '../../data/work';
import { getTexts } from '../../data/cms';

const { esencia } = await getTexts();

// Collage: la diseñadora en su taller (photoshoot). Sin pies de foto (la clienta los quitó, 2026-10-23).
const figures = [
  { photo: byId('proceso-retrato'), variant: 'portrait', parallax: '-0.06', widths: [500, 800, 1100], sizes: '(max-width: 860px) 54vw, 22vw' },
  { photo: byId('proceso-corte'), variant: 'detail', parallax: '-0.22', widths: [400, 700, 1000], sizes: '(max-width: 860px) 40vw, 17vw' },
  { photo: byId('proceso-prueba-tela'), variant: 'mirror', parallax: '-0.14', widths: [400, 700, 1000], sizes: '(max-width: 860px) 34vw, 16vw' },
];
---

<section class="essence" id="esencia" aria-labelledby="esencia-title" data-section="01" data-section-label="Esencia">
  <div class="essence__inner wrap">
    <div class="essence__text">
      <SectionHeading label="Nuestra esencia" />
      <h2 id="esencia-title" class="sr-only">Nuestra esencia</h2>

      <WordReveal text={esencia.manifiesto} class="essence__manifesto display" dropCap />

      <p class="essence__body" data-reveal>
        {esencia.entrada && <span class="essence__lead-in">{esencia.entrada}</span>} {esencia.cuerpo}
      </p>

      <figure class="essence__quote" data-reveal>
        <blockquote class="display">{esencia.cita}</blockquote>
        {esencia.firma && <figcaption>{esencia.firma}</figcaption>}
      </figure>
    </div>

    <div class="essence__collage">
      {figures.map(({ photo, variant, parallax, widths, sizes }) => (
        <div class:list={['essence__item', `essence__item--${variant}`]} data-parallax={parallax}>
          <figure class="essence__photo" data-clip>
            <Image
              src={photo.image}
              alt={photo.alt}
              widths={widths}
              sizes={sizes}
              style={photo.focus ? `object-position: ${photo.focus}` : undefined}
            />
          </figure>
        </div>
      ))}
      <p class="essence__vertical display" aria-hidden="true" data-reveal>Monterrey, N.L.</p>
    </div>
  </div>
</section>

<style>
  .essence {
    padding-block: var(--section-y);
  }

  .essence__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }

  /* :global porque el <p> lo renderiza WordReveal (otro scope) */
  .essence__text :global(.essence__manifesto) {
    margin-top: 1.8rem;
    font-size: var(--text-lead);
    line-height: 1.22;
    max-width: 24ch;
  }

  /* Cuerpo a dos columnas con filete, como una página de revista */
  .essence__body {
    margin-top: 2rem;
    max-width: 38rem;
    columns: 2;
    column-gap: 2.2rem;
    column-rule: 1px solid var(--line);
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--tinta-soft);
  }

  .essence__lead-in {
    font-size: 0.78em;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tinta);
  }

  /* Cita destacada: filete vertical terracota, como un pull quote de revista */
  .essence__quote {
    margin: 2.6rem 0 0;
    padding-left: 1.4rem;
    max-width: 30rem;
    border-left: 1px solid var(--terracota);
  }

  .essence__quote blockquote {
    margin: 0;
    font-size: clamp(1.25rem, 1.7vw, 1.6rem);
    line-height: 1.2;
  }

  .essence__quote figcaption {
    margin-top: 0.9rem;
    font-size: 0.62rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--tinta-soft);
  }

  /* Collage: misma gramática que el hero (fotos sueltas a distintas escalas) */
  .essence__collage {
    position: relative;
    height: clamp(28rem, 50vw, 44rem);
  }

  .essence__item {
    position: absolute;
  }

  .essence__photo {
    margin: 0;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--fondo-soft);
  }

  .essence__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .essence__item--portrait {
    left: 15%;
    top: 0;
    width: 46%;
  }

  .essence__item--detail {
    left: 0;
    bottom: 0;
    width: 36%;
  }

  .essence__item--mirror {
    right: 0;
    top: 34%;
    width: 34%;
  }

  .essence__vertical {
    position: absolute;
    right: 3%;
    top: 0;
    writing-mode: vertical-rl;
    font-size: 1.1rem;
    color: var(--terracota);
  }

  @media (max-width: 860px) {
    .essence__inner {
      grid-template-columns: 1fr;
    }

    .essence__collage {
      height: 118vw;
    }

    .essence__item--portrait {
      left: 10%;
      width: 54%;
    }

    .essence__item--detail {
      width: 40%;
    }

    .essence__item--mirror {
      top: 40%;
      width: 36%;
    }

    .essence__body {
      columns: 1;
    }
  }
</style>
