---
// 03 — Piezas disponibles. La colección a la venta con la misma galería que Diseños: una tarjeta por modelo,
// con sus colores, precio y tallas (las vendidas dicen "Sold out"). Se edita en el panel (data/cms.ts).
// Temporada, intro, título y prendas se editan en el panel (Colección a la venta y Textos de la página).
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import WhatsAppIcon from '../ui/icons/WhatsAppIcon.astro';
import DesignGallery from '../islands/gallery/DesignGallery';
import { collectionGroup } from '../islands/gallery/groups';
import { whatsappLink } from '../../data/site';
import { getCollection, getTexts } from '../../data/cms';

const [{ season, intro }, { disponibles }] = await Promise.all([getCollection(), getTexts()]);
const groups = [await collectionGroup()];
const inquiry = whatsappLink(`Hola Anter House, me interesa una pieza de la colección ${season}.`);
---

<section class="available" id="disponibles" aria-labelledby="disponibles-title" data-section="03" data-section-label="Piezas disponibles">
  <div class="wrap">
    <div class="available__head">
      <SectionHeading label="Piezas disponibles" title={disponibles.titulo} id="disponibles-title" />
      <div class="available__aside" data-reveal>
        <p><span class="available__season">{season}.</span> {intro}</p>
        <Button href={inquiry} variant="outline" external><WhatsAppIcon size={15} /> Preguntar</Button>
      </div>
    </div>
    <div class="available__groups">
      <DesignGallery client:visible groups={groups} variant="shop" />
    </div>
  </div>
</section>

<style>
  .available {
    padding-block: var(--section-y);
  }

  .available__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .available__aside {
    display: grid;
    justify-items: start;
    gap: 1.1rem;
    max-width: 22rem;
  }

  .available__aside p {
    font-size: 0.9rem;
    color: var(--tinta-soft);
  }

  .available__season {
    color: var(--tinta);
  }

  .available__groups {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
</style>
