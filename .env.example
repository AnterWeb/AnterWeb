# Variables del panel (Keystatic en modo GitHub). En producción viven en el proyecto de Vercel de la clienta;
# en local, en .env (nunca en el repo). Sin PUBLIC_KEYSTATIC_GITHUB_REPO, el panel local guarda en los archivos
# del proyecto y el build de producción no incluye el panel. Ver docs/cms.md.

# Repo donde guarda el panel
PUBLIC_KEYSTATIC_GITHUB_REPO=AnterWeb/AnterWeb
# GitHub App del panel (anterweb-keystatic, de la cuenta AnterWeb)
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=anterweb-keystatic
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
# Cadena aleatoria de 32 caracteres o más (cifra la sesión del panel)
KEYSTATIC_SECRET=

# Opcional: fuerza el dominio de canonical, Open Graph y sitemap (en Vercel sale solo)
# SITE_URL=https://anterhouse.com
